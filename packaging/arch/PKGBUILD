# Maintainer: Inkleaf contributors
# Installs a prebuilt Inkleaf release binary on Arch Linux.
# Usage: put this file next to inkleaf-<version>-x86_64.tar.gz and run `makepkg -si`.
pkgname=inkleaf-bin
pkgver=0.7.1
pkgrel=1
pkgdesc="Handwritten note-taking app: notebooks, pen and shapes, handwriting fonts, PDF/PowerPoint export"
arch=('x86_64')
url="https://github.com/sadikBr/goodnotes-clone"
license=('custom' 'OFL-1.1')
depends=('webkit2gtk-4.1' 'gtk3' 'gdk-pixbuf2' 'cairo' 'glib2' 'libsoup3' 'dbus' 'hicolor-icon-theme' 'gcc-libs' 'glibc')
provides=('inkleaf')
conflicts=('inkleaf')
options=('!strip' '!debug')
source=("inkleaf-${pkgver}-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cd "inkleaf-${pkgver}-x86_64"
  install -Dm755 inkleaf "${pkgdir}/usr/bin/inkleaf"
  install -Dm644 inkleaf.desktop "${pkgdir}/usr/share/applications/inkleaf.desktop"
  for size in 32 128 256 512; do
    install -Dm644 "icons/${size}.png" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/inkleaf.png"
  done
  install -Dm644 third-party-licenses.txt "${pkgdir}/usr/share/licenses/${pkgname}/third-party-licenses.txt"
}

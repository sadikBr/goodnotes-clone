{
  "name": "inkleaf",
  "private": true,
  "version": "0.8.0",
  "description": "Inkleaf - a handwritten note-taking desktop app built with Tauri and Rust",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-pdfjs-assets.mjs && vite",
    "build": "node scripts/copy-pdfjs-assets.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "set-version": "node scripts/set-version.mjs"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/indie-flower": "5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/shadows-into-light": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.14.0",
    "opentype.js": "^1.3.4",
    "pdfjs-dist": "6.4.299",
    "perfect-freehand": "1.2.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/opentype.js": "^1.3.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

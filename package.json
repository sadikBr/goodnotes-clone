{
  "name": "inkleaf",
  "private": true,
  "version": "0.1.0",
  "description": "Inkleaf - a handwritten note-taking desktop app built with Tauri and Rust",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/architects-daughter": "5.3.0",
    "@fontsource/caveat": "5.3.0",
    "@fontsource/dancing-script": "5.3.0",
    "@fontsource/indie-flower": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/shadows-into-light": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}

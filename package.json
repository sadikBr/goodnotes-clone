{
  "name": "inkleaf",
  "private": true,
  "version": "0.8.0",
  "description": "Inkleaf - a handwritten note-taking app (Qt and Rust)",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p qt/js",
    "test": "vitest run",
    "set-version": "node scripts/set-version.mjs",
    "qt-icons": "node scripts/qt-icons.mjs",
    "qt-bridge": "node scripts/qt-bridge.mjs"
  },
  "dependencies": {
    "@fontsource/andika": "5.3.0",
    "@fontsource/gochi-hand": "5.3.0",
    "@fontsource/handlee": "5.3.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lora": "5.3.0",
    "@fontsource/mynerve": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/playpen-sans": "5.3.0",
    "@fontsource/playwrite-fr-moderne": "5.3.0",
    "@fontsource/playwrite-fr-trad": "5.3.0",
    "@fontsource/schoolbell": "5.3.0",
    "@fontsource/shantell-sans": "5.3.0",
    "perfect-freehand": "1.2.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
